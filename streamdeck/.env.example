# Copy to .env and fill in your values:
#   cp .env.example .env
#
# The .env file holds a long-lived token — keep it out of version control.

# Home Assistant host. IMPORTANT: there is no separate port setting — the
# connection URI is built as "<protocol>://<HASS_HOST>/api/websocket", so if
# HA does not listen on the protocol's default port (443 for wss, 80 for ws)
# you must include the port here.
#
#   Plain HTTP on the LAN (typical):   10.69.42.3:8123   with WEBSOCKET_PROTOCOL=ws
#   Behind an HTTPS reverse proxy:     ha.example.com    with WEBSOCKET_PROTOCOL=wss
HASS_HOST=10.69.42.3:8123

# WebSocket protocol: "ws" for plain HTTP, "wss" for TLS/HTTPS. Defaults to wss.
# A bare Home Assistant on a LAN IP speaks plain ws — use "ws" for that.
WEBSOCKET_PROTOCOL=ws

# Long-lived access token, created under your HA profile:
#   Profile -> Security -> Long-lived access tokens -> Create Token
HASS_TOKEN=your-long-lived-access-token
