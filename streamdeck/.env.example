# Copy to .env and fill in your values:
#   cp .env.example .env
#
# The .env file holds a long-lived token — keep it out of version control.

# Home Assistant host or IP (no scheme, no port).
HASS_HOST=homeassistant.local

# Port Home Assistant listens on (8123 by default).
HASS_PORT=8123

# Long-lived access token, created under your HA profile:
#   Profile -> Security -> Long-lived access tokens -> Create Token
HASS_TOKEN=your-long-lived-access-token
