# Secrets (one .env per deck — different host/protocol per machine)
.env
decks/*/.env

# Generated deck images (build artifact — run `task icons:all` per machine)
decks/*/icons/

# Icon generator build cache (downloaded MDI font/css) and local venvs
.iconbuild/
.venv/
venv/
decks/*/.venv/

# Python bytecode (ext/ is imported directly from the checkout)
__pycache__/
*.pyc
