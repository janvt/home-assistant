# Stream Deck Plus — on the Raspberry Pi. Copy to .env (`task plus:env`).
#
# The Pi can reach Home Assistant directly on the LAN IP over plain HTTP.
# There is NO separate port setting: the URI is built as
#   <WEBSOCKET_PROTOCOL>://<HASS_HOST>/api/websocket
# so the port goes in HASS_HOST.

HASS_HOST=10.69.42.3:8123
WEBSOCKET_PROTOCOL=ws

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens
HASS_TOKEN=your-long-lived-access-token
