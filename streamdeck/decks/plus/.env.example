# Stream Deck Plus — on the Raspberry Pi. Copy to .env (`task plus:env`).
#
# The Pi can reach Home Assistant directly on the LAN IP over plain HTTP.
# There is NO separate port setting: the URI is built as
#   <WEBSOCKET_PROTOCOL>://<HASS_HOST>/api/websocket
# so the port goes in HASS_HOST.

HASS_HOST=10.69.42.3:8123
WEBSOCKET_PROTOCOL=ws

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens
HASS_TOKEN=your-long-lived-access-token

# Reconnect resilience. The app's OWN default is 0 retries: if HA is
# unreachable on the FIRST attempt, it logs "giving up" and exits 0
# (success). `restart: unless-stopped` in docker-compose.yaml DOES restart
# on that exit (unlike the Mac's launchd KeepAlive, which only restarts a
# FAILED exit) — so this container was never left permanently dark the way
# the Mac deck was. But without this, every HA blip means a full container
# teardown/respawn (slower, noisier in logs, trips the healthcheck) instead
# of the app just reconnecting in place. -1 = retry forever; 10s delay is a
# real sleep between attempts (0 would busy-loop). See the streamdeck-xl
# README's "Reconnect resilience" section for the full story.
CONNECTION_RETRY_ATTEMPTS=-1
CONNECTION_RETRY_DELAY=10
