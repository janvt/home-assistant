# Stream Deck Plus XL — on the Mac. Copy to .env (`task xl:env`).
#
# NOTE the different host/protocol from the Pi: the laptop sits on 10.69.43.x
# and can NOT route to Home Assistant's 10.69.42.3 LAN address, so it goes via
# the public hostname over TLS. There is NO separate port setting — the URI is
#   <WEBSOCKET_PROTOCOL>://<HASS_HOST>/api/websocket
# and wss defaults to 443, so no port is needed here.

HASS_HOST=ha.janvt.dev
WEBSOCKET_PROTOCOL=wss

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens
HASS_TOKEN=your-long-lived-access-token

# Reconnect resilience. The app's OWN default is 0 retries: if HA is
# unreachable on the FIRST attempt, it logs "giving up" and exits 0 (success),
# and launchd's KeepAlive (SuccessfulExit: false) does not restart a
# successful exit — so a single HA blip leaves the deck dark until someone
# manually reruns it. -1 means retry forever; 10s delay is a real sleep
# between attempts (0 would busy-loop). See home_assistant_streamdeck_yaml's
# `run()` for the retry loop these two feed.
CONNECTION_RETRY_ATTEMPTS=-1
CONNECTION_RETRY_DELAY=10
