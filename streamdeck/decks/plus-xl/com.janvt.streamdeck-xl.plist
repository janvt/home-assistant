<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent for the Stream Deck Plus XL (macOS).

  Installed to ~/Library/LaunchAgents/ by `task xl:service` — it runs in your
  LOGIN session (an Agent, not a system Daemon), which is what gives it USB HID
  access to the deck.

  Paths are absolute and machine-specific, matching the icon paths in
  configuration.yaml. If the checkout moves, update WorkingDirectory here and
  re-run `task xl:service`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.janvt.streamdeck-xl</string>

    <!-- Source .env for HASS_HOST/HASS_TOKEN so the secret stays in that file
         (mode 600) rather than being duplicated into this plist. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>set -a; . ./.env; set +a; exec ./.venv/bin/python -m ext.run --config configuration.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/janvt/dev/jan/home-assistant/streamdeck/decks/plus-xl</string>

    <!-- python-elgato-streamdeck locates Homebrew's libhidapi via HOMEBREW_PREFIX,
         falling back to shelling out to `brew`. launchd starts with a minimal
         environment, so set both explicitly rather than relying on a login shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOMEBREW_PREFIX</key>
        <string>/opt/homebrew</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- `ext` (local Mac actions) lives at the streamdeck/ root, two levels
             up from WorkingDirectory. Run via `python -m ext.run`, not the
             console script, so the wrappers are installed before main(). -->
        <key>PYTHONPATH</key>
        <string>/Users/janvt/dev/jan/home-assistant/streamdeck</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it exits non-zero (crash, deck unplugged, an
         unrecoverable error like a bad token). This does NOT cover "HA was
         unreachable": with CONNECTION_RETRY_ATTEMPTS=-1 in .env, the app
         retries forever internally and never exits over that, so it isn't
         relying on launchd to recover from an HA outage — see the README's
         "Reconnect resilience" section. Without that env var (the app's own
         default is 0 retries), a single failed connection attempt exits 0
         ("gave up"), which KeepAlive here would NOT restart, since
         SuccessfulExit is false. ThrottleInterval keeps an unplugged deck
         from respawning in a tight loop — launchd's default is 10s. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/janvt/Library/Logs/streamdeck-xl.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/janvt/Library/Logs/streamdeck-xl.log</string>
</dict>
</plist>
