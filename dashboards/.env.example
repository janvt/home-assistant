# Dashboard sync scripts (mobile-alerts/, weather/). Copy to dashboards/.env.
#
# Same settings as the Stream Decks. From the Mac on 10.69.41.x the LAN
# address works; from 10.69.43.x use HASS_HOST=ha.janvt.dev with
# WEBSOCKET_PROTOCOL=wss. REST calls use http/https to match.

HASS_HOST=10.69.42.3:8123
WEBSOCKET_PROTOCOL=ws

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens
HASS_TOKEN=your-long-lived-access-token
